PORT=8787

# CannaAI data source: mock | api
# mock keeps this public starter self-contained with synthetic fixtures.
# api connects to a real CannaAI server.
CANNAAI_MODE=mock
CANNAAI_BASE_URL=http://localhost:3000
CANNAAI_API_TOKEN=
CANNAAI_REQUEST_TIMEOUT_MS=15000

# Reserved for the guarded write/automation parity stage. Both remain off by default.
CANNAAI_ENABLE_WRITE_TOOLS=false
CANNAAI_ENABLE_AUTOMATION=false

# Optional. Required only for the local analyze_plant_snapshot fallback tool.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5

# Camera integration mode: mock | http
CAMERA_MODE=mock

# Used when CAMERA_MODE=http. Supports placeholders {plantId} and {cameraId}.
# Example: https://cannaai.example.com/api/cameras/{cameraId}/snapshot.jpg
CAMERA_SNAPSHOT_URL_TEMPLATE=

# Optional bearer token sent to your camera/CannaAI endpoint.
CAMERA_BEARER_TOKEN=
